# Swiss LeadGen — 环境变量
# 复制为 .env 并填写真实值

# ── Lead Discovery（免费，无需信用卡）
# 注册 https://app.outscraper.com → 500条/月免费
OUTSCRAPER_API_KEY=

# ── Lead Enrichment（免费，无需信用卡）
# 注册 https://serper.dev → 2,500次一次性免费
SERPER_API_KEY=

# ── OpenAI
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o

# ── GitHub
GITHUB_TOKEN=
GITHUB_ORG=          # 留空使用个人账号

# ── Vercel
VERCEL_TOKEN=
VERCEL_TEAM_ID=      # 留空使用个人账号

# ── GoDaddy
GODADDY_API_KEY=
GODADDY_API_SECRET=
ROOT_DOMAIN=tubban.com

# ── Email (Resend，3000封/月免费)
# 注册 https://resend.com
RESEND_API_KEY=
FROM_EMAIL=hello@tubban.com
FROM_NAME=Tubban Websites

# ── 数据库
# 推荐 Neon（免费）: https://neon.tech
DATABASE_URL=

# ── Stripe（第五阶段，可选）
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
